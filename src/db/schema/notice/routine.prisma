model Routine {
  id        String   @id @default(uuid())
  day       String   // "Sunday", "Monday"
  startTime String   // "10:00 AM" (String or DateTime can be used logic wise)
  endTime   String   // "10:45 AM"

  // Routine Connects 3 entities:
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])

  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  // Validation Logic backend e likhte hobe jate double booking na hoy
  @@map("routines")
}