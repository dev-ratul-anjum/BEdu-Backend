model Student {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  rollNo      Int      @unique
  dateOfBirth DateTime
  gender      Gender
  bloodGroup  String?
  address     String?

  // Connection with User (Auth)
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Connection with Academic Structure
  classId String
  class   Class  @relation(fields: [classId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  parentId String?
  parent   Parent? @relation(fields: [parentId], references: [id])

  // Reverse Relations (Data access korar jonno)
  attendances Attendance[]
  results     Result[]
  // transactions Transaction[]
  // studentFees StudentFee[] // Individual invoice records

  @@map("students")
}
