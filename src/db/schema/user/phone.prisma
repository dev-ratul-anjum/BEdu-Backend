model Phone {
    id             String  @id @default(uuid())
    aditional_info String?
    number         String  @unique

    teacher    Teacher? @relation(fields: [teacher_id], references: [id])
    teacher_id String?
    admin      Admin?   @relation(fields: [admin_id], references: [id])
    admin_id   String?

    @@map("phones")
}
