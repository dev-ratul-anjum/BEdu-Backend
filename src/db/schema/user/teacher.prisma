model Teacher {
  id          String    @id @default(uuid())
  name        String
  email       String?   @unique
  degree      String?
  indexNumber String?
  designation String?
  joiningDate DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  classTeacherOf Class[]

  routines Routine[]
  phone    Phone[]

  @@map("teachers")
}
