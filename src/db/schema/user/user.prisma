model User {
  id       String   @id @default(uuid())
  username String   @unique
  password String
  role     UserRole

  admin_profile      Admin?
  teacher_profile    Teacher?
  student_profile    Student?
  parent_profile     Parent?
  superAdmin         SuperAdmin?
  biometric_user     BiometricUser?
  attendance_dailies AttendanceDaily[]

  @@map("users")
}
