model Class {
  id   String @id @default(uuid())
  name String // "Class 6", "Class 10"

  academic_year_id String
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id])

  // Class Teacher (Optional)
  class_teacher_id String?
  class_teacher    Teacher? @relation(fields: [class_teacher_id], references: [id])

  // Relations
  sections Section[]
  students Student[]
  subjects Subject[]
  routines Routine[]
  // feeStructures FeeStructure[] // Class wise fee alada hoy

  @@map("classes")
}
