model Subject {
  id   String  @id @default(uuid())
  name String // "Mathematics"
  code String? // "MATH101"

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id])
  results   Result[]

  @@map("subjects")
}
