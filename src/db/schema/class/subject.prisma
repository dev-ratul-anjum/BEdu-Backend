model Subject {
  id   String  @id @default(uuid())
  name String // "Mathematics"
  code String? // "MATH101"

  class_id String
  class    Class  @relation(fields: [class_id], references: [id])

  routine_id String
  routine    Routine  @relation(fields: [routine_id], references: [id])
  results    Result[]

  @@map("subjects")
}
